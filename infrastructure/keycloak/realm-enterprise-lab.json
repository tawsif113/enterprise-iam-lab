{
  "realm": "enterprise-lab",
  "enabled": true,
  "displayName": "Enterprise IAM Lab",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "Authenticated employee"
      },
      {
        "name": "support-agent",
        "description": "Ticket support agent"
      },
      {
        "name": "portal-admin",
        "description": "Portal administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "employee-portal",
      "name": "Employee Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:9001/callback"
      ],
      "webOrigins": [
        "http://localhost:9001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9001/"
      },
      "protocolMappers": [
        {
          "name": "ticket-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticket-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ticket-console",
      "name": "Ticket Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:9002/callback"
      ],
      "webOrigins": [
        "http://localhost:9002"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:9002/"
      },
      "protocolMappers": [
        {
          "name": "ticket-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticket-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ticket-api",
      "name": "Ticket API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "identityProviders": [
    {
      "alias": "corporate-oidc",
      "displayName": "Corporate IdP (OIDC)",
      "providerId": "oidc",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "http://localhost:8180/realms/corporate/protocol/openid-connect/auth",
        "tokenUrl": "http://external-keycloak:8080/realms/corporate/protocol/openid-connect/token",
        "logoutUrl": "http://localhost:8180/realms/corporate/protocol/openid-connect/logout",
        "userInfoUrl": "http://external-keycloak:8080/realms/corporate/protocol/openid-connect/userinfo",
        "issuer": "http://localhost:8180/realms/corporate",
        "jwksUrl": "http://external-keycloak:8080/realms/corporate/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "enterprise-lab-broker",
        "clientSecret": "broker_secret_dev",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "corporate-users-are-employees",
      "identityProviderAlias": "corporate-oidc",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "role": "employee"
      }
    }
  ]
}
